{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  assignees: [ "mikejovyan" ],
  extends: [
    "local>renovate-bot/renovate_config",
  ],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [ "/^recipes/.*\\.ya?ml$/" ],
      matchStrings: [
        "base-image:\\s*(?<depName>\\S+)\\s*\\n\\s*image-version:\\s*[\"']?(?<currentValue>\\d+)[\"']?",
      ],
      datasourceTemplate: "docker",
    },
  packageRules: [
    // The sign flags in build.yml work around rpm-ostree#5509: bump cosign by hand and check signing
    {
      matchPackageNames: [ "sigstore/cosign" ],
      enabled: false,
    },
  ],

  // List each major on the dashboard, otherwise only the newest one (Rawhide) is offered
  separateMultipleMajor: true,
}
