{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  assignees: [ "mikejovyan" ],
  extends: [
    "local>renovate-bot/renovate_config",
  ],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [ "/^recipes/.*\\.yml$/" ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s*\\n\\s*image-version:\\s*[\"']?(?<currentValue>\\d+)[\"']?",
      ],
    },
  ],  
  packageRules: [
    {
      matchFileNames: [ "recipes/**/*.yml" ],
      pinDigests: false,
    },
    {
      matchPackageNames: [ "sigstore/cosign" ],
      enabled: false,
    },
  ],
  // List each major on the dashboard
  separateMultipleMajor: true,
}
